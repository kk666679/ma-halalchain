# HalalChain Environment Variables
# --------------------------------
# Blockchain RPCs
ETH_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
SOLANA_RPC_URL=https://api.devnet.solana.com
XRPL_WSS=wss://s.altnet.rippletest.net:51233

# IPFS / Pinata
PINATA_JWT=your_pinata_jwt
FILECOIN_TOKEN=your_filecoin_token

# Payment Gateways
STRIPE_SECRET=sk_test_...
PAYPAL_CLIENT=your_paypal_client
MIDTRANS_SERVER_KEY=your_midtrans_key

# ERPs / Accounting
ODOO_API_KEY=your_odoo_key
XERO_CLIENT_ID=your_xero_client
QUICKBOOKS_TOKEN=your_qb_token

# CRM / Marketing
HUBSPOT_ACCESS_TOKEN=your_hubspot_token
TWILIO_ACCOUNT_SID=your_twilio_sid

# Slack (for hooks)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Database
DATABASE_URL=postgresql://halalchain:halalchain@localhost:5432/langgraph

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Agent Settings
AGENT_MODE=production
